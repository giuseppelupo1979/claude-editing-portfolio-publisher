{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/editing-portfolio-publisher/site-profile.schema.json",
  "title": "Editing Portfolio Publisher SSH site profile",
  "type": "object",
  "required": ["profile_version", "id", "provider", "cms_url", "site_url", "ssh", "directus", "rebuild", "verification"],
  "properties": {
    "profile_version": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "provider": { "const": "directus-over-ssh" },
    "cms_url": { "type": "string", "format": "uri", "pattern": "^https://" },
    "site_url": { "type": "string", "format": "uri", "pattern": "^https://" },
    "ssh": {
      "type": "object",
      "required": ["host", "port", "user", "identity_file", "remote_workdir", "remote_helper"],
      "properties": {
        "host": { "type": "string", "minLength": 1 },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "user": { "type": "string", "pattern": "^[a-z_][a-z0-9_-]*$" },
        "identity_file": { "type": "string", "pattern": "^/" },
        "remote_workdir": { "type": "string", "pattern": "^/" },
        "remote_helper": { "type": "string", "pattern": "^/" }
      },
      "additionalProperties": false
    },
    "directus": {
      "type": "object",
      "required": ["token_file", "collections", "fields"],
      "properties": {
        "token_file": { "type": "string", "pattern": "^/" },
        "collections": {
          "type": "object",
          "required": ["photos", "galleries"],
          "properties": {
            "photos": { "type": "string", "minLength": 1 },
            "galleries": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        "fields": {
          "type": "object",
          "required": ["photo", "gallery"],
          "properties": {
            "photo": { "$ref": "#/$defs/fieldMap" },
            "gallery": { "$ref": "#/$defs/fieldMap" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "rebuild": {
      "type": "object",
      "required": ["command"],
      "properties": {
        "command": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      },
      "additionalProperties": false
    },
    "verification": {
      "type": "object",
      "required": ["routes"],
      "properties": {
        "routes": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "expected_text": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "fieldMap": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          { "type": "string", "minLength": 1 },
          { "type": "null" }
        ]
      }
    }
  },
  "additionalProperties": false
}
