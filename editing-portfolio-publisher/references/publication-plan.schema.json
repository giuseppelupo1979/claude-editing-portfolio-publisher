{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/editing-portfolio-publisher/publication-plan.schema.json",
  "title": "Editing Portfolio Publisher publication plan",
  "type": "object",
  "required": ["plan_version", "profile_id", "source_dir", "gallery", "photos", "approval"],
  "properties": {
    "plan_version": { "const": 2 },
    "profile_id": { "type": "string", "minLength": 1 },
    "source_dir": { "type": "string", "minLength": 1 },
    "gallery": {
      "type": "object",
      "required": ["action", "slug", "title_it", "title_en", "description_it", "description_en", "cover_file"],
      "properties": {
        "action": { "enum": ["create", "existing"] },
        "existing_id": { "type": ["string", "null"] },
        "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "title_it": { "type": "string", "minLength": 1 },
        "title_en": { "type": "string", "minLength": 1 },
        "description_it": { "type": "string", "minLength": 1 },
        "description_en": { "type": "string", "minLength": 1 },
        "cover_file": { "type": "string", "minLength": 1 },
        "sort": { "type": ["integer", "null"] },
        "filter_flag": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "photos": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["order", "file", "title_it", "title_en", "alt_it", "alt_en", "place", "lat", "lng", "location_source", "location_precision"],
        "properties": {
          "order": { "type": "integer", "minimum": 1 },
          "file": { "type": "string", "minLength": 1 },
          "title_it": { "type": "string", "minLength": 1 },
          "title_en": { "type": "string", "minLength": 1 },
          "alt_it": { "type": "string", "minLength": 1 },
          "alt_en": { "type": "string", "minLength": 1 },
          "place": { "type": "string", "minLength": 1 },
          "lat": { "type": "number", "minimum": -90, "maximum": 90 },
          "lng": { "type": "number", "minimum": -180, "maximum": 180 },
          "location_source": { "enum": ["explicit", "analysis", "exif", "reverse-geocoded", "project-default", "mixed"] },
          "location_precision": { "enum": ["exact", "approximate"] },
          "camera": { "type": ["string", "null"] },
          "taken_at": { "type": ["string", "null"] },
          "featured": { "type": "boolean" },
          "street": { "type": "boolean" },
          "portrait": { "type": "boolean" },
          "description_working": { "type": ["string", "null"] },
          "caption": { "type": ["string", "null"] }
        },
        "additionalProperties": false
      }
    },
    "approval": {
      "type": "object",
      "required": ["approved"],
      "properties": {
        "approved": { "type": "boolean" },
        "approved_at": { "type": ["string", "null"] },
        "approved_by": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
